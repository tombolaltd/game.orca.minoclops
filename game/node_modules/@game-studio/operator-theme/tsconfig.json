{
    "extends": "../../tools/typescript/tsconfig.base.json",
    "compilerOptions": {
        "strictPropertyInitialization": false,
        "declaration": true,
        "declarationDir": "dist/types",
        "outDir": "dist/esm/",
        "typeRoots": [
            "./node_modules/@types",
            "../../node_modules/@types"
        ],
        "lib": [
            "dom",
            "es2015",
            "es5",
            "es6"
        ]
    },
    "include": [
        "src/**/*.ts",
        "./*.js"
    ],
    "exclude": [
        "../../node_modules",
        "./node_modules"
    ]
}