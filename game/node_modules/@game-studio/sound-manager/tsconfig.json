{
    "extends": "../../tools/typescript/tsconfig.base.json",
    "compilerOptions": {
        "strictPropertyInitialization": false,
        "declaration": true,
        "downlevelIteration": true,
        "declarationDir": "./dist/types/",
        "typeRoots": [
            "../../node_modules/@types",
            "./node_modules/@types",
            "./typings"
        ],
        "outDir": "./dist/esm/"
    },
    "include": [
        "tests/**/*.spec.ts",
        "src/**/*.ts",
        "./*.js"
    ],
    "exclude": [
        "../../node_modules",
        "./node_modules"
    ]
}