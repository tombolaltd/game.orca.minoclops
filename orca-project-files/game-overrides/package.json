{
	"name": "@arcade-client/minoclops",
	"version": "0.0.0",
	"description": "tombola arcade minoclops",
	"author": "tombola",
	"publishConfig": {
		"registry": "https://packages.tombola.com/repository/npm-private-client/"
	},
	"scripts": {
		"preserve": "node build/copy-runtime-assets.js",
		"serve": "cross-env NODE_OPTIONS=--max-old-space-size=8192 webpack-dev-server --progress --config build/webpack.dev.conf.js --stats errors-warnings",
		"build": "node build/build.js",
		"lint": "npx eslint './build/**/*.js' './src/**/*.ts'",
		"lint-fix": "npx eslint './src/**/*.ts' --fix",
		"format": "npx prettier --check 'src/**/*.ts'",
		"format-fix": "npx prettier --write 'src/**/*.ts'"
	},
	"//dependencies": "PINNED to the 09-08.15-03.LF.eae4a498 batch, which is NOT the newest. The 09-09 and 09-14 pixi-8 batches made arcade-base's companion-state watcher `{ immediate: true }`; it dereferences the circular `device` export at import time, before `Device.initialise()` has assigned it, so every game logs `Cannot read properties of undefined (reading 'viewport')` at boot. Verify `grep -c 'immediate:!0' node_modules/@game-studio/arcade-base/dist/index.js` is 0 before bumping. All seven pixi-coupled packages below MUST stay on one batch (see //overrides).",
	"dependencies": {
		"@esotericsoftware/spine-pixi-v8": "4.2.96",
		"@game-studio/arcade-base": "16.0.0-pixi-8.26-09-08.15-03.LF.eae4a498.0",
		"@game-studio/bindings": "2.0.0-pixi-8.26-09-08.15-03.LF.eae4a498.0",
		"@game-studio/generic-reels": "3.0.0-pixi-8.26-09-08.15-03.LF.eae4a498.0",
		"@game-studio/htp-preview-vue2": "0.3.0-htp.26-09-01.09-05.bf.ad63fe6c.0",
		"@pixi/layout": "^3.2.1",
		"core-js": "^3.40.0",
		"custom-event": "^1.0.1",
		"custom-event-polyfill": "^0.3.0",
		"eventemitter3": "^5.0.1",
		"gsap": "^3.15.0",
		"howler": "^2.2.4",
		"inversify": "^5.0.5",
		"penpal": "^3.0.3",
		"pixi-filters": "^6.1.5",
		"pixi.js": "8.14.3",
		"reflect-metadata": "^0.2.2",
		"three": "^0.186.1",
		"vue": "2.7.10",
		"webfontloader": "^1.6.28",
		"yoga-layout": "^3.2.1"
	},
	"devDependencies": {
		"@babel/core": "^7.13.14",
