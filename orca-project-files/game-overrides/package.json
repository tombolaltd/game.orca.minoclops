	"//overrides": "arcade-base declares its transitive @game-studio/* deps as CARETS ON PRERELEASES (^5.0.0-pixi-8.26-...), which admits any later prerelease of that major, so npm silently mixes build batches and the resulting API skew crashes at runtime. Pin them to the same batch as the direct deps above. htp-preview-core is the same hazard on the SEPARATE htp release line: htp-preview-vue2 declares it as ^0.3.0-htp.26-09-01..., so pin it to the batch that package was built against.",
	"overrides": {
		"@game-studio/asset-manager": "6.0.0-pixi-8.26-09-08.15-03.LF.eae4a498.0",
		"@game-studio/cabinet": "5.0.0-pixi-8.26-09-08.15-03.LF.eae4a498.0",
		"@game-studio/htp-preview-core": "0.3.0-htp.26-09-01.09-05.bf.ad63fe6c.0",
		"@game-studio/sound-manager": "5.0.0-pixi-8.26-09-08.15-03.LF.eae4a498.0"
	},
	"engines": {
		"node": ">= 14.0.0",
		"npm": ">= 7.0.0"
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not ie <= 8"
	]
}
