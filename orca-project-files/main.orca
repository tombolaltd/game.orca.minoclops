  "customEvents": [
    {
      "name": "bonusTease",
      "description": "Base grid landed with 2 BONUS: show the honest bonus tease."
    },
    {
      "name": "splitReveal",
      "description": "Base grid landed: reveal the gold 1x1 hotspot and split its symbol."
    },
    {
      "name": "showStep",
      "description": "Present the current step: persistence splits, ways, wins and the win count-up."
    },
    {
      "name": "cascadeStep",
      "description": "Clear the winning cells and drop the next grid in."
    },
    {
      "name": "stepsDone",
      "description": "Every step of the current spin has been shown."
    },
    {
      "name": "bonusTrigger",
      "description": "3+ BONUS on the final base grid: present the free spins award."
    },
    {
      "name": "bonusStart",
      "description": "Enter free spins: bonus look, counters and the intro popup."
    },
    {
      "name": "bonusSpin",
      "description": "Request and land the next free spin."
    },
    {
      "name": "bonusSplit",
      "description": "Free spin landed: reveal the reel hotspot and split every symbol on it."
    },
    {
      "name": "bonusSpinEnd",
      "description": "A free spin finished: play the next one or end the bonus."
    },
    {
      "name": "bonusEnd",
      "description": "All free spins played: show the bonus total and return to the base game."
    },
    {
      "name": "settleRound",
      "description": "Round over: big-win ladder, cabinet message, end the game."
    },
    {
      "name": "symbolsSplitting",
